# Auth0 — create a *Regular Web Application* (not a SPA; Next.js needs a client secret).
# Allowed Callback URL: http://localhost:3000/auth/callback
# Allowed Logout URL:   http://localhost:3000
AUTH0_SECRET=            # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=            # e.g. dev-2zis9k18.us.auth0.com  (no https://)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional: only needed if you also want an access token for a separate API.
# AUTH0_AUDIENCE=https://liendo-interview.com

# Neon
DATABASE_URL=            # postgresql://...neon.tech/neondb?sslmode=require

# Anthropic (drives the claims agent)
ANTHROPIC_API_KEY=
