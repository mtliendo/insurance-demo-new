# Copy to .env.local and fill in. Never commit real secrets.
# See SETUP.md for how each value is obtained.

APP_BASE_URL=http://localhost:3000

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# AUTH0_AUDIENCE=

DATABASE_URL=
ANTHROPIC_API_KEY=

# Required — host gate fails closed if both are empty.
DEMO_HOST_EMAIL=
DEMO_HOST_SUB=

# CIBA board. Stage defaults: pick 6, release after 3 yeses.
# Rehearsal (Focus, no six Auth0 accounts): BOARD_SIZE=2 CIBA_YES_THRESHOLD=2
# Do not hardcode the stage demo to 2. Restart / redeploy after changing these.
BOARD_SIZE=6
CIBA_YES_THRESHOLD=3
