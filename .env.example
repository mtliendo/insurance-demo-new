# Copy to .env.local and fill in. Never commit real secrets.
# See SETUP.md for how each value is obtained.

APP_BASE_URL=http://localhost:3000

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# AUTH0_AUDIENCE=

DATABASE_URL=
ANTHROPIC_API_KEY=

# Required — host gate fails closed if both are empty.
DEMO_HOST_EMAIL=
DEMO_HOST_SUB=

# Board size and CIBA yes threshold are set on /host (Board rules),
# stored in Neon demo_settings. Stage default is pick 6 / 3 yeses.
# Rehearsal: set 2 and 2 in the host UI. Do not hardcode the stage demo to 2.
